    parser.add_argument("--loki-password", dest="loki_password", default=None)
    parser.add_argument("--loki-proxy", dest="loki_proxy", default=None)

    # Environment for the test container, every mode (spec 023 FR-001)
    parser.add_argument("--environ", dest="environ", action="append", default=[],
                        metavar="NAME[=VALUE]",
