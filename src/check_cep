def build_env_vars(ctx: RunContext) -> Dict[str, str]:
    """Build the complete container environment (spec 023, design D1).

    The single builder: every value is real, and the dict is written in
    precedence order so later writes win — (1) infrastructure variables incl.
    plugin credentials (FR-012), (2) `--environ` in every mode (FR-001),
    (3) the authoring overlay (FR-007), (4) the display variables (FR-048).
    build_podman_command() passes each name bare (`--env NAME`); the values
    reach podman only through its process environment (FR-004, R-01).
    """
    env = {
        "TEST_SOURCE": ctx.config.test_source,
        "RESULT_DEST": ctx.config.result_dest,
        "LOGGING": ctx.config.logging,
        "NAGIOS_HOSTNAME": ctx.hostname,
        "NAGIOS_SERVICEDESC": ctx.servicedescription,
        "PWTIMEOUT": str(ctx.config.timeout),
        "PROBE_LOCATION": ctx.config.probe_location,
        "TESTIDENT": ctx.testident,
        "TERM": "dumb",
        "FORCE_COLOR": "false",
        "CEP_STARTED": ctx.started_str,
        "CEP_PLUGIN_VERSION": CEP_VERSION,
    }

    if ctx.config.debug:
        env["DEBUG"] = "1"

    if ctx.config.headed or ctx.config.vnc:
        env["HEADED"] = "1"

    env["BROWSER"] = ctx.config.browser

    # Spectate mode: pass through slow-motion and highlight timing
    for passthrough in ("CEP_VISION_HIGHLIGHT_MS", "CEP_SLOW_MO"):
        val = os.environ.get(passthrough)
        if val:
            env[passthrough] = val

    # S3 credentials (when S3 plugins active)
    if ctx.config.s3_endpoint:
        env["S3_ENDPOINT"] = ctx.config.s3_endpoint
    if ctx.config.aws_access_key_id:
        env["AWS_ACCESS_KEY_ID"] = ctx.config.aws_access_key_id
    if ctx.config.aws_secret_access_key:
        env["AWS_SECRET_ACCESS_KEY"] = ctx.config.aws_secret_access_key
    # S3 reads its single artifact key; local layers travel as JSON
    # (spec 023, contracts/container-io.md §2).
    if ctx.config.test_source == "s3" and ctx.config.test_artifacts:
        env["TEST_ARTIFACT"] = ctx.config.test_artifacts[0]
    if ctx.layers:
        env["TEST_ARTIFACT_LAYERS"] = json.dumps([asdict(layer) for layer in ctx.layers])
    if ctx.config.s3_report_bucket:
        env["S3_REPORT_BUCKET"] = ctx.config.s3_report_bucket
    if ctx.config.s3_report_path:
        env["REPORT_PATH"] = ctx.config.s3_report_path

    # Loki credentials (when logging=loki)
    if ctx.config.loki_endpoint:
        env["LOKI_ENDPOINT"] = ctx.config.loki_endpoint
    if ctx.config.loki_user:
        env["LOKI_USER"] = ctx.config.loki_user
    if ctx.config.loki_password:
        env["LOKI_PASSWORD"] = ctx.config.loki_password
    if ctx.config.loki_proxy:
        env["LOKI_PROXY"] = ctx.config.loki_proxy

    # Naemon state info
    if ctx.config.current_status:
        env["NAGIOS_CURRENT_STATUS"] = ctx.config.current_status

    # --environ in every mode; the last occurrence of a name wins. A bare
    # name takes the host value (FR-003 guarantees it is set).
    for name, value in ctx.config.environ:
        env[name] = os.environ.get(name, "") if value is None else value

    # Overlay path wins over a stray `--environ OPENCODE_CONFIG=…` so the
    # bind-mounted file is what opencode actually reads.
    if ctx.config.authoring and ctx.config.opencode_config:
        env["OPENCODE_CONFIG"] = OPENCODE_CONFIG_CONTAINER_PATH

    # The plugin's display variables win over an --environ of the same name.
    # With --vnc the container starts its own X server, which a forwarded
    # DISPLAY/WAYLAND_DISPLAY would suppress (FR-048).
    if ctx.config.vnc:
        for name in ("DISPLAY", "WAYLAND_DISPLAY"):
            env.pop(name, None)
    env.update(display_forwarding(ctx)[0])
    return env


def display_forwarding(ctx: RunContext) -> Tuple[Dict[str, str], List[str]]:
    """Display env and podman args for --headed/--vnc (spectate mode, FR-048).

    Returns ({} , []) for headless runs. One owner for all display handling:
    VNC, Wayland, local X11 and SSH-forwarded X11.
    """
    if not (ctx.config.headed or ctx.config.vnc):
        return {}, []
    env: Dict[str, str] = {}
    args = [
        f"--userns=keep-id:uid={CONTAINER_UID},gid={CONTAINER_GID}",
        "--security-opt", "label=disable",
        "--ipc=host",
    ]
    if ctx.config.vnc:
        # VNC fallback: container starts Xtigervnc internally and serves
        # it on port 5900.  The host connects with vncviewer.  Use this
        # when direct display forwarding fails (e.g. Wayland + SELinux).
        args.extend(["--publish", "127.0.0.1:5900:5900"])
    elif detect_display_server() == "wayland":
        # Wayland: forward the compositor socket so the browser window
        # appears on-screen via the native Wayland path.
        wayland_display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        wayland_socket = os.path.join(xdg_runtime, wayland_display)
        args.extend(["--volume", f"{wayland_socket}:{wayland_socket}:ro"])
        env["WAYLAND_DISPLAY"] = wayland_display
        env["XDG_RUNTIME_DIR"] = xdg_runtime
    else:
        display = os.environ.get("DISPLAY", ":0")
        xauthority = os.environ.get("XAUTHORITY", os.path.expanduser("~/.Xauthority"))
        if display.startswith(":"):
            # Local X11 — forward via Unix socket
            args.extend(["--volume", "/tmp/.X11-unix:/tmp/.X11-unix:ro"])
        else:
            # Remote/SSH-forwarded X11 (e.g. localhost:10.0) — the display is
            # TCP-based.  Use host networking so the container can reach the
            # SSH-forwarded port on loopback.
            args.append("--network=host")
        env["DISPLAY"] = display
        if os.path.exists(xauthority):
            args.extend(["--volume", f"{xauthority}:/tmp/.Xauthority:ro"])
            env["XAUTHORITY"] = "/tmp/.Xauthority"
    return env, args


# ---------------------------------------------------------------------------
# Authoring workspace resolution (spec 020)
# ---------------------------------------------------------------------------

def authoring_workspace_dir(ctx: RunContext) -> str:
    """Resolve the site-level authoring workspace (--authoring mode only).

    Unlike the per-service test mount (`.../tests/%h/%s`), authoring mounts the
    SITE-LEVEL directory (`.../tests/%h`) so the session can read/write the
    shared KNOWLEDGE.md and create sibling test folders. Overridable via
    --test-dir. Returns an absolute path (may not exist — callers validate).
    """
    raw_dir = ctx.config.test_dir or (ctx.omd_root + "/etc/check_cep/tests/%h")
    return os.path.abspath(resolve_path_template(
        raw_dir, ctx.hostname, ctx.servicedescription, ctx.started_str))


# ---------------------------------------------------------------------------
# Podman command construction
# ---------------------------------------------------------------------------

def build_podman_command(ctx: RunContext, container_bin: str,
                         env_vars: Dict[str, str]) -> List[str]:
    """Build complete podman run command."""
    cgroup_parent = ctx.container_name.replace("-", "_") + ".slice"

    cmd = [
        container_bin,
        "run",
        "--rm",
        "--interactive",
        "--log-driver=none",
        "--hostname", os.uname().nodename,
        "--name", ctx.container_name,
        "--cgroup-parent", cgroup_parent,
    ]

    # Resource limits (FR-006: CPU hardcoded at 2)
    cmd.extend(["--cpus", str(DEFAULT_CPU_COUNT)])
    memory_limit = ctx.config.memory_limit if ctx.config.memory_limit else DEFAULT_MEMORY_LIMIT
    if memory_limit and memory_limit[-1] not in "bkmg":
        memory_limit += "g"
    cmd.extend(["--memory", memory_limit])

    # Environment variables: names only (spec 023 R-01). Podman takes each
    # value from its own process environment (see main()), so no value — no
    # secret, no credential — ever appears in this argv or the debug log.
    for key in env_vars:
        cmd.extend(["--env", key])
    # FR-011: the container environment has exactly three sources — image
    # defaults, check_cep's variables above, and --environ. Podman must not
    # add host proxy variables (default http_proxy=true) or the host env (a
    # site's env_host=true). A check behind a proxy names it explicitly:
    # --environ HTTPS_PROXY --environ NO_PROXY (or use.proxy in its config).
    cmd.extend(["--http-proxy=false", "--env-host=false"])

    # Conditional volume mounts
    if ctx.config.authoring:
        # Authoring mode (spec 020): mount the SITE-LEVEL workspace READ-WRITE
        # so the session can read/write KNOWLEDGE.md and create sibling test
        # folders. Gated behind --authoring; scheduled runs never take this path.
        cmd.extend(["--volume",
                    f"{authoring_workspace_dir(ctx)}:/home/pwuser/tests:rw,z"])
        # Provider/model overlay — beside the baked opencode.json, never over it.
        if ctx.config.opencode_config:
            cmd.extend(["--volume",
                        f"{ctx.config.opencode_config}:"
                        f"{OPENCODE_CONFIG_CONTAINER_PATH}:ro,z"])
    # Every local layer read-only under /home/pwuser/layers/; the container
    # merges them into its own writable /home/pwuser/tests (spec 023,
    # contracts/container-io.md §1).
    for layer in ctx.layers:
        cmd.extend(["--volume", f"{layer.host_path}:{layer.container_path}:ro,z"])
    cmd.extend(["--volume", f"{os.path.abspath(ctx.result_dir)}:/home/pwuser/results:rw,z"])
    if ctx.config.test_source == "s3":
        cache_dir = ctx.config.testscripts_cache
        cmd.extend(["--volume", f"{os.path.abspath(cache_dir)}:/home/pwuser/testscripts-cache:rw,z"])

    # Headed mode: display forwarding for spectating (FR-048)
    cmd.extend(display_forwarding(ctx)[1])

    # Authoring mode: map the container user to the host operator so writes to
    # the read-write site workspace are owned correctly (create test folders,
    # KNOWLEDGE.md, packages). Mirrors the headed keep-id; skipped when headed
    # already added it. Authoring-only — scheduled runs are untouched.
    if ctx.config.authoring and not (ctx.config.headed or ctx.config.vnc):
        cmd.extend([
            f"--userns=keep-id:uid={CONTAINER_UID},gid={CONTAINER_GID}",
            "--security-opt", "label=disable",
        ])

    # Shell mode: replace entrypoint with bash
    if ctx.config.shell:
        cmd.extend(["--tty", "--interactive", "--entrypoint", "bash"])

    cmd.append(ctx.config.image)
    # A debug shell sees exactly what a check runs (spec 023 FR-032): build
    # the check root (merged layers) first; a merge error exits 3 without a shell.
    # Authoring shells work on their rw workspace and are unchanged.
    if ctx.config.shell and not ctx.config.authoring:
        cmd.extend(["-c", "python3 /home/pwuser/run.py --prepare-only && exec bash -i"])
    return cmd


# ---------------------------------------------------------------------------
# Container execution
# ---------------------------------------------------------------------------

def execute_container(cmd: List[str], shell_mode: bool = False,
                      env: Optional[Dict[str, str]] = None) -> Tuple[bytes, bytes, int]:
    """Execute podman run and return (stdout, stderr, returncode).

    `env` is the podman process environment that carries the values of the
    bare `--env NAME` arguments (spec 023 R-01).
    """
    logger.debug("running command: %s", " ".join(cmd))
    if shell_mode:
        proc = subprocess.run(cmd, env=env)
        return b"", b"", proc.returncode
    else:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        return proc.stdout, proc.stderr, proc.returncode




# ---------------------------------------------------------------------------
# Registry authentication retry
# ---------------------------------------------------------------------------

def retry_with_auth(container_bin: str, cmd: List[str], image: str,
                    username: str, password: str,
                    env: Optional[Dict[str, str]] = None) -> Tuple[bytes, bytes, int]:
    """Attempt podman login and retry the container command.

    A failure returns podman exit code 125 with podman's own message, so it
    classifies as UNKNOWN (spec 023 FR-052), never as a test failure. The
    password goes through stdin, never through argv (FR-012).
    """
    if "/" not in image:
        return b"", f"Error: cannot log in: image {image} names no registry".encode(), EXIT_AUTH_REQUIRED

    registry = image.split("/")[0]
    login_cmd = [container_bin, "login", "-u", username, "--password-stdin", registry]
    logger.debug("login as %s at registry %s", username, registry)
    login = subprocess.run(login_cmd, input=(password or "").encode(),
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    if login.returncode == 0:
        logger.debug("re-running command: %s", " ".join(cmd))
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        return proc.stdout, proc.stderr, proc.returncode
    else:
        logger.debug("login failed")
        return login.stdout, login.stderr, EXIT_AUTH_REQUIRED


# ---------------------------------------------------------------------------
# Results parsing (steps.json)
# ---------------------------------------------------------------------------

# A previous run's report is minutes old; seconds of slack cover coarse mtimes.
STEPS_JSON_MTIME_SLACK = 2.0


def parse_steps_json(json_path: str, not_before: Optional[float] = None) -> Optional[dict]:
    """Parse steps.json file. Returns parsed dict or None.

    A file older than not_before was left by an earlier run (this run ended
    before Playwright wrote a report) and is ignored. STEPS_JSON_MTIME_SLACK
    allows for filesystems with whole-second timestamps.
    """
    try:
        if not_before is not None and \
                os.path.getmtime(json_path) < not_before - STEPS_JSON_MTIME_SLACK:
            logger.debug(f"Ignoring {json_path}: written by an earlier run")
            return None
        with open(json_path, "r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (json.JSONDecodeError, OSError) as e:
        logger.warning(f"Could not parse {json_path}: {e}")
        return None


def stdio_text(entry: Any) -> str:
    """Text of one Playwright stdout/stderr entry: `text`, or base64 `buffer`.

    Must stay identical to run.py's copy (spec 023 FR-053); invalid entries
    and undecodable buffers count as empty.
    """
    if not isinstance(entry, dict):
        return ""
    if isinstance(entry.get("text"), str):
        return entry["text"]
    if isinstance(entry.get("buffer"), str):
        try:
            return base64.b64decode(entry["buffer"], validate=True).decode("utf-8", "replace")
        except (binascii.Error, ValueError):
            return ""
    return ""


def report_has_visible_stderr(obj: Any) -> bool:
    """True if any `stderr` list anywhere in the report has visible content.

    Searches the whole report, retries included (spec 023 FR-053). Must stay
    identical to run.py's copy.
    """
    if isinstance(obj, dict):
        stderr = obj.get("stderr")
        if isinstance(stderr, list) and any(stdio_text(e).strip() for e in stderr):
            return True
        return any(report_has_visible_stderr(v) for v in obj.values())
    if isinstance(obj, list):
        return any(report_has_visible_stderr(v) for v in obj)
    return False


def report_has_errors(subjson: dict) -> bool:
    """True if the report root or a test's first result has `errors` (FR-054).

    Visits the same nodes as extract_output_from_steps: root, suites, specs
    and `tests[*].results[0]` (retries are not considered).
    """
    if subjson.get("errors"):
        return True
    for child in subjson.get("suites", []) + subjson.get("specs", []):
        if report_has_errors(child):
            return True
    for test in subjson.get("tests", []):
        if test.get("results") and report_has_errors(test["results"][0]):
            return True
    return False


_TEST_SUFFIX_RE = re.compile(r"\.(spec|test)\.(ts|js|mts|cts|mjs|cjs|tsx|jsx)$")


def _suite_name(title: str, keep_path: bool) -> str:
    """One root suite's name (spec 023 FR-051, data-model §7).

    `.test.ts` and `.test.js` keep their legacy forms (stripped / unstripped)
    so existing perfdata histories stay intact; other spec/test suffixes are
    stripped. Setup/teardown files (`auth.setup.ts`) keep their suffix, as
    they always did (FR-051). keep_path uses the relative path with "/" as
    a word break.
    """
    if keep_path:
        return _TEST_SUFFIX_RE.sub("", title).replace("/", " ")
    name = os.path.basename(title)
    if name.endswith(".test.ts"):
        return name[:-len(".test.ts")]
    if name.endswith(".test.js"):
        return name
    return _TEST_SUFFIX_RE.sub("", name)


def root_suite_prefixes(suites: List[dict]) -> List[str]:
    """Names for several root suites; colliding names fall back to the path."""
    names = [_suite_name(s["title"], keep_path=False) for s in suites]
    keys = [camelcase(n) for n in names]
    return [_suite_name(s["title"], keep_path=True) if keys.count(k) > 1 else n
            for s, n, k in zip(suites, names, keys)]


def ensure_unique_labels(perfdata: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Last-resort guard (SC-007): suffix repeated labels with _2, _3, ..."""
    taken = {pd["label"] for pd in perfdata}  # never collide with a natural label
    seen = set()
    result = []
    for pd in perfdata:
        label = pd["label"]
        if label in seen:
            n = 2
            while f"{label}_{n}" in taken:
                n += 1
            label = f"{label}_{n}"
            taken.add(label)
        seen.add(label)
        result.append(pd if label == pd["label"] else {**pd, "label": label})
    return result


def extract_perfdata_from_steps(subjson: dict, level: int = 0, prefix: str = "") -> List[Dict[str, Any]]:
    """Recursively extract perfdata from steps.json structure.

    Returns list of perfdata dicts with label, value, unit.
    """
    perfdata = []

    suites = subjson.get("suites", [])
    names = root_suite_prefixes(suites) if level == 0 and len(suites) > 1 else []
    for index, suite in enumerate(suites):
        if names:
            new_prefix = camelcase(names[index])
        elif level == 0:
            new_prefix = prefix
        else:
            new_prefix = prefix + camelcase(suite["title"])
        perfdata.extend(extract_perfdata_from_steps(suite, level + 1, new_prefix))

    for spec in subjson.get("specs", []):
        new_prefix = prefix + camelcase(spec["title"])
        perfdata.extend(extract_perfdata_from_steps(spec, level + 1, new_prefix))

    for test in subjson.get("tests", []):
        if len(subjson["tests"]) > 1:
            new_prefix = prefix + camelcase(test["projectName"])
        else:
            new_prefix = prefix
        if len(test["results"]) > 0:
            perfdata.extend(extract_perfdata_from_steps(test["results"][0], level + 1, new_prefix))
            if "duration" in test["results"][0]:
                perfdata.append({"label": new_prefix + "_td", "value": test["results"][0]["duration"], "unit": "ms"})

        # Annotation-based perfdata
        for annotation in test.get("annotations", []):
            if "type" in annotation and annotation["type"].startswith("perfdata_"):
                m = re.match(r"([\d]+\.*[\d]*)([a-z%]*)", annotation.get("description", ""))
                if m:
                    suffix = "_cd" if m[2] and m[2].endswith("s") else "_cm"
                    # Project-qualified, so several projects stay distinct (FR-051)
                    perfdata.append({
                        "label": new_prefix + camelcase(annotation["type"].replace("perfdata_", "") + suffix),
                        "value": m[1],
                        "unit": m[2],
                    })

    for step in subjson.get("steps", []):
        new_prefix = prefix + camelcase(step["title"])
        perfdata.append({"label": new_prefix + "_sd", "value": step["duration"], "unit": "ms"})
        perfdata.extend(extract_perfdata_from_steps(step, level + 1, new_prefix))

    return perfdata


def extract_output_from_steps(subjson: dict, level: int = 0, prefix: str = "", debug: bool = False) -> Tuple[str, bool]:
    """Recursively extract stdout/stderr/errors from steps.json.

    Returns (output_text, has_stderr).
    """
    output = ""
    has_stderr = False

    suites = subjson.get("suites", [])
    names = root_suite_prefixes(suites) if level == 0 and len(suites) > 1 else []
    for index, suite in enumerate(suites):
        if names:
            new_prefix = names[index]
        elif level == 0:
            new_prefix = prefix
        else:
            new_prefix = prefix + " - " + suite["title"]
        sub_output, sub_stderr = extract_output_from_steps(suite, level + 1, new_prefix, debug)
        output += sub_output
        has_stderr = has_stderr or sub_stderr

    for spec in subjson.get("specs", []):
        sub_output, sub_stderr = extract_output_from_steps(spec, level + 1, prefix + " - " + spec["title"], debug)
        output += sub_output
        has_stderr = has_stderr or sub_stderr

    for test in subjson.get("tests", []):
        if len(subjson["tests"]) > 1:
            new_prefix = prefix + " - " + test["projectName"]
        else:
            new_prefix = prefix
        if len(test["results"]) > 0:
            sub_output, sub_stderr = extract_output_from_steps(test["results"][0], level + 1, new_prefix, debug)
            output += sub_output
            has_stderr = has_stderr or sub_stderr

    for index, stdout_entry in enumerate(subjson.get("stdout", [])):
        if index == 0:
            output += "\n__Stdout " + prefix + "__"
        text = stdio_text(stdout_entry)
        if text.startswith("NagiosPerfData:"):
            continue
        if text.lstrip().startswith("[CEPDBG]") and not debug:
            continue
        output += "\n" + text.rstrip()

    # Only visible entries count (spec 023 FR-053): Playwright's empty
    # {"buffer": ""} must neither print a section nor cause a WARNING.
    stderr_lines = [stdio_text(e).rstrip() for e in subjson.get("stderr", [])
                    if stdio_text(e).strip()]
    if stderr_lines:
        output += "\n__Stderr " + prefix + "__"
        for line in stderr_lines:
            output += "\n" + line
        has_stderr = True

    for index, error in enumerate(subjson.get("errors", [])):
        if index == 0:
            output += "\n__Errors " + prefix + "__"
        msg = error.get("message", "")
        sanitized = sanitize_output(replace_emojis(msg).encode("utf-8"))
        output += "\n" + truncate_playwright_diff(sanitized).rstrip()

    return output, has_stderr


def extract_nagios_perfdata_from_stdout(subjson: dict, level: int = 0) -> List[Dict[str, Any]]:
    """Extract NagiosPerfData: lines from stdout in steps.json."""
    perfdata = []

    for suite in subjson.get("suites", []):
        perfdata.extend(extract_nagios_perfdata_from_stdout(suite, level + 1))
    for spec in subjson.get("specs", []):
        perfdata.extend(extract_nagios_perfdata_from_stdout(spec, level + 1))
    for test in subjson.get("tests", []):
        if len(test.get("results", [])) > 0:
            perfdata.extend(extract_nagios_perfdata_from_stdout(test["results"][0], level + 1))

    for stdout_entry in subjson.get("stdout", []):
        text = stdio_text(stdout_entry)
        m = re.match(r"NagiosPerfData:\s*'(.*?)'=([\d]+\.?[\d]*)([a-z%]*)", text)
        if m:
            perfdata.append({"label": m[1], "value": m[2], "unit": m[3]})

    return perfdata


def normalize_perfdata_labels(perfdata: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Normalize perfdata labels: strip suffixes for display."""
    num_tests = sum(1 for pd in perfdata if pd["label"].endswith("_td"))

    if num_tests == 1:
        # Single test: simplify labels
        name_test = None
        for pd in perfdata:
            if pd["label"].endswith("_td"):
                name_test = re.sub(r"_td$", "", pd["label"])
                break
        if name_test:
            result = []
            for pd in perfdata:
                label = pd["label"]
                if label.endswith("_td"):
                    result.append({"label": "TestDuration", "value": pd["value"], "unit": pd.get("unit", "")})
                elif any(label.endswith(s) for s in ["_sd", "_cd", "_cm"]):
                    result.append({"label": label.replace(name_test, ""), "value": pd["value"], "unit": pd.get("unit", "")})
                else:
                    result.append(pd)
            perfdata = result
    else:
        # Multiple tests: expand _td to _test_duration
        perfdata = [
            {"label": re.sub(r"_td$", "_test_duration", pd["label"]), "value": pd["value"], "unit": pd.get("unit", "")}
            if pd["label"].endswith("_td") else pd
            for pd in perfdata
        ]

    # Strip remaining suffixes for final output
    result = []
    for pd in perfdata:
        label = pd["label"]
        for suffix in ["_sd", "_cd", "_cm"]:
            label = re.sub(f"{suffix}$", "", label)
        result.append({"label": label, "value": pd["value"], "unit": pd.get("unit", "")})
    return result


# ---------------------------------------------------------------------------
# Container output analysis
# ---------------------------------------------------------------------------

def check_timeout(stdout: str, stderr: str) -> bool:
    """Detect timeout from container output.

    Two sources:
    - Playwright's own per-test timeout message (when playwright.config.ts
      timeout fires before the outer coreutils timeout)
    - PWTIMEOUT_EXCEEDED marker printed by run.py when coreutils timeout (124/137)
      kills the Playwright process before it can print its own message
    """
    return bool(
        "PWTIMEOUT_EXCEEDED" in stdout
        or "ran into a timeout after" in stderr
        or re.search(r"Test timeout of \d+ms exceeded", stdout)
        or re.search(r"Timeout \d+ms exceeded", stdout)
    )


def extract_cep_unknown(stdout: str) -> Optional[str]:
    """Return the reason of the first `CEPUNKNOWN [[[msg]]]` marker, or None.

    run.py prints the marker right before it exits 3 (spec 023, R-09).
    """
    m = re.search(r"CEPUNKNOWN \[\[\[(.*?)\]\]\]", stdout)
    return m.group(1) if m else None


def strip_cep_unknown(text: str) -> str:
    """Remove `CEPUNKNOWN [[[msg]]]` marker lines; the status line shows the reason."""
    return re.sub(r"^CEPUNKNOWN \[\[\[.*?\]\]\][ \t]*(?:\n|$)", "", text, flags=re.M)


def extract_podman_error(stderr: str) -> str:
    """Return podman's first `Error:` line (else the last non-empty line), capped."""
    lines = [line.strip() for line in stderr.splitlines() if line.strip()]
    if not lines:
        return ""
    error = next((line for line in lines if line.startswith("Error:")), lines[-1])
    return error[:PODMAN_ERROR_MAX_LEN]


class ContainerOutcome(NamedTuple):
    """Everything classify_result() needs to know about a finished container run."""
    rc: int
    oom_killed: bool
    timed_out: bool
    duplicate: bool
    auth_failed: bool
    cep_unknown: Optional[str]
    has_stderr_in_steps: bool
    has_report_errors: bool
    podman_error: str = ""


def classify_result(outcome: ContainerOutcome, service: str, host: str) -> Tuple[str, str]:
    """Map a container run to (Nagios status, summary) — spec 023 FR-052.

    CRITICAL only when Playwright reported a failure (container exit 2) or a
    passed report carries `errors` (FR-054). Anything that kept the tests from
    running properly — OOM kill, podman's own failures, run.py's exit 3,
    unexpected exit codes — is UNKNOWN. Order: contracts/nagios-output.md §0.
    """
    rc = outcome.rc
    if outcome.oom_killed:
        return "UNKNOWN", f"test {service} OOM killed"
    if rc in PODMAN_FAILURE_CODES:
        error = f": {outcome.podman_error}" if outcome.podman_error else ""
        if outcome.duplicate:
            return "UNKNOWN", f"test {service} duplicate, running on host {host}"
        if rc == EXIT_AUTH_REQUIRED and outcome.auth_failed:
            return "UNKNOWN", (f"podman failed for test {service} on host {host} "
                               f"(podman exit code {rc}){error}")
        return "UNKNOWN", (f"test {service} could not be started on host {host} "
                           f"(podman exit code {rc}){error}")
    if rc == EXIT_UNKNOWN:
        if outcome.cep_unknown:
            return "UNKNOWN", f"test {service}: {outcome.cep_unknown}"
        return "UNKNOWN", f"test {service} failed"
    if rc in (EXIT_OK, EXIT_WARNING):
        if outcome.has_report_errors:
            return "CRITICAL", f"test {service} failed"
        if rc == EXIT_WARNING or outcome.has_stderr_in_steps:
            return "WARNING", f"test {service} succeeded"
        return "OK", f"test {service} succeeded"
    if rc == EXIT_CRITICAL:
        if outcome.timed_out:
            return "CRITICAL", f"test {service} timed out"
        return "CRITICAL", f"test {service} failed"
    return "UNKNOWN", f"test {service} ended with unexpected exit code {rc} on host {host}"


def check_s3_upload_failure(stdout: str, stderr: str) -> bool:
    """Detect S3 upload failure from container output."""
    return "S3UPLOADHASFAILED" in stderr or "S3UPLOADHASFAILED" in stdout


def check_duplicate_container(stderr: str) -> bool:
    """Detect duplicate container error."""
    return "Error: creating container storage" in stderr and "is already in use" in stderr


def log_version_mismatch(result_dir: str) -> None:
    """Log a plugin/image version mismatch from test-meta.json (spec 024 FR-016).

    Diagnostic only: unknown versions are not compared, and an unreadable or
    incomplete test-meta.json is ignored — the check result never depends on it.
    """
    try:
        with open(os.path.join(result_dir, "test-meta.json"), encoding="utf-8") as f:
            versions = json.load(f)["versions"]
        plugin, image = versions["plugin"], versions["image"]
    except (OSError, ValueError, KeyError, TypeError):
        return
    if not (isinstance(plugin, str) and isinstance(image, str)):
        return
    if "unknown" in (plugin, image) or plugin == image:
        return
    logger.debug(f"version mismatch: plugin {plugin}, image {image}")


