def resolve_report_url(ctx: RunContext, timestamp: str) -> str:
    """Resolve report URL template variables."""
    url = ctx.config.report_url
    url = url.replace("%h", ctx.hostname)
    url = url.replace("%s", ctx.servicedescription)
    url = url.replace("%i", ctx.testident)
    url = url.replace("%l", ctx.config.probe_location)
    url = url.replace("%b", ctx.config.s3_report_bucket or "")
    url = url.replace("%t", timestamp)
    return url


