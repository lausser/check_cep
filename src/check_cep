# ---------------------------------------------------------------------------
# Test name derivation and path template resolution
# ---------------------------------------------------------------------------

def derive_testname(hostname: str, servicedescription: str) -> str:
    """Derive TESTNAME from hostname and service description.

    TESTNAME is symbolic, not a path. Used as container name and PID identity.
    """
    return f"{hostname}/{servicedescription}"


def derive_testident(hostname: str, servicedescription: str) -> str:
    """Derive URL-encoded TESTIDENT for PID files and archive names."""
    return urllib.parse.quote(f"{hostname}__{servicedescription}", safe="")


def resolve_path_template(template: str, hostname: str,
                          servicedescription: str,
                          started_str: str = "") -> str:
    """Replace %h, %s, and %t template variables in path strings."""
    result = template.replace("%h", hostname).replace("%s", servicedescription)
    if started_str:
        result = result.replace("%t", started_str)
    return result


def resolve_layers(config: RunConfig, omd_root: str, hostname: str,
                   servicedescription: str, started_str: str) -> List[Layer]:
    """Expand and validate the local test layers (spec 023 FR-025, FR-031).

    Without --test-artifact, the implicit default or --test-dir is the only
    layer. Raises ValueError with the resolved path (contracts/cli.md §1).
    """
    implicit = not config.test_artifacts
    values = config.test_artifacts or (
        config.test_dir or omd_root + "/etc/check_cep/tests/%h/%s",)
    layers = []
    for position, raw in enumerate(values, 1):
        path = os.path.abspath(resolve_path_template(
            raw, hostname, servicedescription, started_str))
        if os.path.isdir(path):
            layer_type, suffix = "directory", ""
        elif os.path.isfile(path) and path.endswith((".tgz", ".tar.gz")):
            layer_type, suffix = "archive", ".tgz"
        elif not os.path.exists(path):
            if implicit:
                raise ValueError(f"test directory ({path}) does not exist")
            raise ValueError(f"--test-artifact #{position} ({path}): does not exist")
        else:
            where = f"test directory ({path})" if implicit else f"--test-artifact #{position} ({path})"
            raise ValueError(f"{where}: must be a directory or a .tgz/.tar.gz file")
        layers.append(Layer(position, path, layer_type,
                            f"/home/pwuser/layers/{position:02d}{suffix}"))
    return layers


def select_layers(config: RunConfig, omd_root: str, hostname: str,
                  servicedescription: str, started_str: str) -> Tuple[Layer, ...]:
    """The layers this run mounts; empty for S3 and --authoring (FR-028/029).

    Raises ValueError for usage errors; warns when --authoring ignores layers.
    """
    count = len(config.test_artifacts)
    if config.test_source == "s3":
        if count > 1:
            raise ValueError(f"--test-source s3 supports exactly one --test-artifact (got {count})")
        return ()
    if config.authoring:
        if count > 1:
            print(f"WARNING: --authoring ignores --test-artifact ({count} given)",
                  file=sys.stderr, flush=True)
        return ()
    return tuple(resolve_layers(config, omd_root, hostname, servicedescription, started_str))


def sanitize_container_name(testname: str) -> str:
    """Sanitize testname for use as Podman container name."""
    return re.sub(r"[^a-zA-Z0-9_.-]+", "_", testname.replace(" ", "_"))


# ---------------------------------------------------------------------------
# PID file concurrency control
# ---------------------------------------------------------------------------

def is_process_running(pid: int) -> bool:
    """Check if a process with given PID is running."""
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def check_pid_file(pid_file_path: str) -> Optional[int]:
    """Check PID file. Returns existing PID if running, None otherwise."""
    if not os.path.exists(pid_file_path):
        return None
    try:
        with open(pid_file_path, "r") as f:
            existing_pid = int(f.read().strip())
        if is_process_running(existing_pid):
            return existing_pid
        else:
            logger.debug(f"Found stale PID {existing_pid}. Overwriting.")
            return None
    except (ValueError, IOError) as e:
        logger.warning(f"Could not read PID file {pid_file_path}: {e}")
        return None


def write_pid_file(pid_file_path: str) -> None:
    """Write current PID to file."""
    with open(pid_file_path, "w") as f:
        f.write(str(os.getpid()))


def remove_pid_file(pid_file_path: str) -> None:
    """Remove PID file if it exists."""
    try:
        if os.path.exists(pid_file_path):
            os.remove(pid_file_path)
    except OSError as e:
        logger.warning(f"Could not remove PID file {pid_file_path}: {e}")


